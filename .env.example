# ===== AUTH =====
# PIN (numeric) untuk masuk ke panel admin /admin. GANTI dari default!
ADMIN_PASSWORD=0099

# Rahasia penandatangan cookie sesi admin. Kalau kosong, fallback diturunkan
# dari ADMIN_PASSWORD — set nilai acak panjang biar sesi nggak bisa dipalsukan
# bahkan kalau PIN bocor. Contoh: openssl rand -hex 32
SESSION_SECRET=

# ===== STORAGE (Cloudflare D1) =====
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# ===== IMAGE UPLOAD (Cloudinary) =====
# Dipakai untuk upload avatar / banner / favicon / OG tanpa URL manual.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
