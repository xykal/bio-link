# Copy to .env.local for local development; never commit real credentials.
# Production variables belong in the deployment provider's encrypted env settings.

# Admin / sessions (leave unset locally to use the development-only defaults)
# ADMIN_PASSWORD=replace-with-a-unique-passphrase
# SESSION_SECRET=generate-at-least-32-random-bytes
# CRON_SECRET=generate-a-separate-random-secret

# Cloudflare D1 (optional for local development; required for shared production storage)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Cloudinary media uploads (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
