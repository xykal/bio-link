# ===== AUTH =====
# Password untuk masuk ke panel admin (WAJIB diganti di produksi!)
ADMIN_PASSWORD=admin123

# Hashed / rahasia path untuk panel admin.
# URL admin = https://domain-mu/<ADMIN_SECRET_PATH>
# (tidak pernah ditampilkan di UI — hanya kamu yang tahu)
ADMIN_SECRET_PATH=af4ec7529f2d7353

# ===== STORAGE (Cloudflare D1) =====
# Isi ketiganya untuk menggunakan Cloudflare D1 (recommended untuk Vercel).
# Kalau kosong, app otomatis pakai file lokal (cocok untuk dev).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
