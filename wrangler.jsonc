{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bio-link",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "bio-link"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bio-link",
      "database_id": "7ba20cf2-1b91-40f2-94c2-a69d5e249143"
    }
  ],
  "triggers": {
    "crons": ["15 20 * * *"]
  },
  // Custom domain sengaja TIDAK dipasang di sini dulu: record DNS lama
  // (CNAME ke Vercel) di zone haekal.web.id masih ada, dan selama itu
  // `wrangler deploy` gagal di langkah trigger (error 100117) sehingga deploy
  // di CI ikut merah. Setelah record lama dihapus, tambahkan custom domain
  // sekali lewat Dashboard (Workers & Pages -> bio-link -> Settings ->
  // Domains & Routes -> Add custom domain) atau hidupkan blok berikut:
  //
  // "routes": [
  //   { "pattern": "bio.haekal.web.id", "custom_domain": true }
  // ],
  "workers_dev": true
}
